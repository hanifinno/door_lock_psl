// ================= WIFI =================
const char *ssid = "HitchHiker";
const char *password = "noc@pkcl";
IPAddress local_IP(10, 81, 100, 72);
IPAddress gateway(10, 81, 100, 1);
IPAddress subnet(255, 255, 255, 0);
