#include <Arduino.h>
#line 1 "/Users/psl/hanif_3.0/Door-lock-ai-main/Door-lock-ai-main.ino"
#include <HTTPClient.h>
#include <SPIFFS.h>
#include <TFT_eSPI.h>
#include <TJpg_Decoder.h>
#include <WebServer.h>
#include <WiFi.h>

// ================= WIFI CONFIG =================
const char *ssid = "HitchHiker";
const char *password = "noc@pkcl";

// Static IP
IPAddress local_IP(10, 81, 100, 72);
IPAddress gateway(10, 81, 100, 1);
IPAddress subnet(255, 255, 255, 0);
IPAddress dns(8, 8, 8, 8);

// ================= SERVER =================
WebServer server(80);

// ================= SPIFFS PATHS =================
#define BG_ON "/images/bg4.jpg"
#define BG_IDLE "/images/bg4.jpg"

// ================= PINS =================
#define RELAY_PIN 22
#define GREEN_LED 17
#define BACKLIGHT_PIN 21

// ================= DISPLAY =================
TFT_eSPI tft;

// ================= STATE =================
unsigned long actionStart = 0;
bool activeMode = false;

// ================= JPEG CALLBACK =================
bool tft_output(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t *bitmap) {
  if (y >= tft.height())
    return true;
  tft.pushImage(x, y, w, h, bitmap);
  return true;
}

// ================= SAFE JPG RENDERER =================
bool drawJpgSafe(int16_t x, int16_t y, const char *path) {
  String candidates[4];
  String p = String(path);
  candidates[0] = p.startsWith("/images/") ? p : ("/images" + (p.startsWith("/") ? p : ("/" + p)));
  candidates[1] = p;
  candidates[2] = p.startsWith("/") ? p.substring(1) : ("/" + p);
  candidates[3] = p.startsWith("/images/") ? p.substring(1) : ("images" + (p.startsWith("/") ? p : ("/" + p)));

  String validPath = "";
  for (int i = 0; i < 4; i++) {
    File testFile = SPIFFS.open(candidates[i].c_str(), "r");
    if (testFile) {
      size_t sz = testFile.size();
      testFile.close();
      if (sz > 0) {
        validPath = candidates[i];
        break;
      }
    }
  }

  if (validPath.length() == 0) {
    Serial.print("Error: Image not found in SPIFFS: ");
    Serial.println(path);
    return false;
  }

  Serial.print("Drawing image: ");
  Serial.println(validPath);
  return TJpgDec.drawFsJpg(x, y, validPath.c_str(), SPIFFS);
}

// ================= RELAY LOGIC (INVERTED) =================
void openDoor() {
  digitalWrite(RELAY_PIN, LOW);   // OPEN (LOW)
  digitalWrite(GREEN_LED, HIGH);  // Green LED ON
}

void closeDoor() {
  digitalWrite(RELAY_PIN, HIGH);  // CLOSE (HIGH)
  digitalWrite(GREEN_LED, LOW);   // Green LED OFF
}

// ================= BACKGROUND =================
void drawBackground(const char *path) {
  tft.setRotation(0); // Portrait Mode
  drawJpgSafe(0, 0, path);
}

// ================= DRAW ACCESS GRANTED ON SCREEN =================
void drawAccessCard(String name, String empId) {
  tft.setRotation(0); // Portrait (240x320)

  // 1. Draw Background Image first
  drawBackground(BG_ON);

  // 2. Overlay modern Employee Access Card
  int cardX = 15;
  int cardY = 85;
  int cardW = 210;
  int cardH = 200;

  // Translucent dark slate card with bright green border
  tft.fillRoundRect(cardX, cardY, cardW, cardH, 10, 0x0160); // Dark Navy/Green
  tft.drawRoundRect(cardX, cardY, cardW, cardH, 10, TFT_GREEN);
  tft.drawRoundRect(cardX + 1, cardY + 1, cardW - 2, cardH - 2, 9, TFT_GREEN);

  // Big Green Status Badge
  tft.fillCircle(120, cardY + 32, 20, TFT_GREEN);
  tft.setTextColor(TFT_BLACK, TFT_GREEN);
  tft.setTextSize(2);
  tft.drawCentreString("OK", 120, cardY + 25, 2);

  // Title: "ACCESS GRANTED"
  tft.setTextColor(TFT_GREEN, 0x0160);
  tft.setTextSize(2);
  tft.drawCentreString("ACCESS GRANTED", 120, cardY + 60, 2);

  // Employee Name
  tft.setTextColor(TFT_WHITE, 0x0160);
  if (name.length() > 0) {
    if (name.length() > 15) {
      tft.setTextSize(1);
      tft.drawCentreString(name, 120, cardY + 90, 2);
    } else {
      tft.setTextSize(2);
      tft.drawCentreString(name, 120, cardY + 86, 2);
    }
  } else {
    tft.setTextSize(2);
    tft.drawCentreString("AUTHORIZED USER", 120, cardY + 86, 2);
  }

  // Employee ID Badge Pill
  if (empId.length() > 0) {
    tft.fillRoundRect(35, cardY + 120, 170, 28, 6, 0x00A0);
    tft.drawRoundRect(35, cardY + 120, 170, 28, 6, 0x5E3F);
    tft.setTextColor(TFT_CYAN, 0x00A0);
    tft.setTextSize(2);
    String idDisplay = "ID: " + empId;
    tft.drawCentreString(idDisplay, 120, cardY + 126, 1);
  }

  // Door Status Indicator
  tft.setTextColor(TFT_YELLOW, 0x0160);
  tft.setTextSize(1);
  tft.drawCentreString("DOOR UNLOCKED", 120, cardY + 165, 2);
}

// ================= IDLE MODE =================
void enterIdle() {
  drawBackground(BG_IDLE);
  closeDoor(); // SAFE STATE = CLOSE
  activeMode = false;
  Serial.println("[System] Idle Standby active.");
}

// ================= UNIFIED UNLOCK HANDLER =================
void processUnlockRequest(const char* source) {
  String empId = "";
  String name = "";

  if (server.hasArg("employee_id")) {
    empId = server.arg("employee_id");
  } else if (server.hasArg("emp")) {
    empId = server.arg("emp");
  } else if (server.hasArg("id")) {
    empId = server.arg("id");
  }

  if (server.hasArg("name")) {
    name = server.arg("name");
  } else if (server.hasArg("employee_name")) {
    name = server.arg("employee_name");
  }

  Serial.println("\n==========================================");
  Serial.print("[API Request] Endpoint: ");
  Serial.println(source);
  Serial.print("[Employee Name]: ");
  Serial.println(name.length() > 0 ? name : "(None)");
  Serial.print("[Employee ID]  : ");
  Serial.println(empId.length() > 0 ? empId : "(None)");
  Serial.println("==========================================");

  // 1. Show Access Card with Name & ID on screen
  drawAccessCard(name, empId);

  // 2. Unlock Door
  openDoor();

  // 3. Keep active for 5 seconds
  actionStart = millis();
  activeMode = true;

  // 4. Send 200 OK
  server.send(200, "text/plain", "DOOR UNLOCKED");
}

void handleOn() {
  processUnlockRequest("/on");
}

void handleSilent() {
  processUnlockRequest("/silent");
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);

  // Pins
  pinMode(RELAY_PIN, OUTPUT);
  pinMode(GREEN_LED, OUTPUT);

  // Turn ON Backlight (Active-LOW on CYD: LOW = ON)
  pinMode(BACKLIGHT_PIN, OUTPUT);
  digitalWrite(BACKLIGHT_PIN, LOW);
  pinMode(27, OUTPUT); digitalWrite(27, HIGH);
  pinMode(4, OUTPUT);  digitalWrite(4, HIGH);
  pinMode(16, OUTPUT); digitalWrite(16, HIGH);

  // SAFE START → DOOR CLOSED
  closeDoor();

  // TFT Display Setup
  tft.init();
  tft.setRotation(0); // Portrait Mode
  tft.fillScreen(TFT_BLACK);

  // JPEG Decoder Setup
  TJpgDec.setSwapBytes(true);
  TJpgDec.setCallback(tft_output);

  // SPIFFS
  if (!SPIFFS.begin(true)) {
    Serial.println("SPIFFS ERROR");
    return;
  }

  // Connect to WiFi
  WiFi.config(local_IP, gateway, subnet, dns);
  WiFi.begin(ssid, password);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(400);
    Serial.print(".");
    attempts++;
  }

  Serial.println("\nWiFi Connected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  // Server Routes
  server.on("/on", handleOn);
  server.on("/silent", handleSilent);
  server.on("/unlock", handleOn);
  server.on("/open", handleOn);
  server.begin();
  Serial.println("[Server] HTTP Server started.");

  // Draw Initial Standby Background
  enterIdle();
}

// ================= LOOP =================
void loop() {
  server.handleClient();

  if (activeMode && millis() - actionStart > 5000) {
    enterIdle();
  }
}
